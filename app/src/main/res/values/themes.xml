<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Pos2" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- ธีมที่ไม่มี ActionBar และพื้นหลังสีขาว -->
    <style name="Theme.Pos2.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item> <!-- พื้นหลังสีขาว -->
        <item name="android:statusBarColor">@android:color/white</item> <!-- สีของแถบสถานะ -->
        <item name="android:navigationBarColor">@android:color/white</item> <!-- สีของแถบนำทาง -->
    </style>

    <style name="Theme.Pos2.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Pos2.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
