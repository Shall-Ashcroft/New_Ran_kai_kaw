<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pos2"
        tools:targetApi="31" >

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="Login"
            android:theme="@style/Theme.AppCompat.NoActionBar" > <!-- ใช้ธีมที่ไม่มี ActionBar -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Pos2.NoActionBar" />
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:label="Dashboard"
            android:theme="@style/Theme.Pos2.NoActionBar" >

            <!-- Add an intent filter if you want to launch the activity from a different activity -->
        </activity>
        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="true"
            android:label="Register"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>